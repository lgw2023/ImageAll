{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/integrations/story-render-package/0.2",
  "title": "StoryRenderPackage v0.2 mixed media",
  "description": "Photo and original video clips with explicit source frame ranges and original audio gain.",
  "type": "object",
  "required": [
    "schemaVersion",
    "projectID",
    "projectRevision",
    "export",
    "assets",
    "chapters",
    "trace"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.2"
    },
    "projectID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "projectRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "export": {
      "type": "object",
      "required": [
        "width",
        "height",
        "fps",
        "totalFrames",
        "background",
        "template"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 240,
          "maximum": 7680
        },
        "height": {
          "type": "integer",
          "minimum": 240,
          "maximum": 7680
        },
        "fps": {
          "type": "integer",
          "const": 30
        },
        "totalFrames": {
          "type": "integer",
          "minimum": 1
        },
        "background": {
          "type": "object",
          "required": [
            "color",
            "mode"
          ],
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "mode": {
              "type": "string",
              "enum": [
                "solid",
                "blurred-photo"
              ]
            },
            "blurPixels": {
              "type": "number",
              "minimum": 0,
              "maximum": 80
            },
            "dimOpacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "template": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "const": "family-photo-story"
            },
            "version": {
              "type": "string",
              "const": "0.1"
            },
            "title": {
              "type": "string",
              "maxLength": 240
            },
            "subtitle": {
              "type": "string",
              "maxLength": 320
            },
            "closingText": {
              "type": "string",
              "maxLength": 320
            },
            "fontFamily": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "textColor": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "accentColor": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "safeMarginRatio": {
              "type": "number",
              "minimum": 0.03,
              "maximum": 0.2
            },
            "titleFontSize": {
              "type": "number",
              "minimum": 24,
              "maximum": 120
            },
            "captionFontSize": {
              "type": "number",
              "minimum": 16,
              "maximum": 80
            },
            "fontWeight": {
              "type": "integer",
              "enum": [
                400,
                700
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "assetID",
          "relativePath",
          "mediaType",
          "sourceContentVersion",
          "renderFileSHA256"
        ],
        "properties": {
          "assetID": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "mediaType": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "image/png",
              "audio/wav",
              "audio/mpeg",
              "audio/mp4",
              "video/mp4",
              "video/quicktime"
            ]
          },
          "sourceContentVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "renderFileSHA256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "video": {
            "type": "object",
            "required": [
              "durationMs",
              "hasAudio"
            ],
            "properties": {
              "durationMs": {
                "type": "integer",
                "minimum": 1
              },
              "hasAudio": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "mediaType": {
                  "enum": [
                    "video/mp4",
                    "video/quicktime"
                  ]
                }
              },
              "required": [
                "mediaType"
              ]
            },
            "then": {
              "required": [
                "video"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "video"
                ]
              }
            }
          }
        ]
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "chapterID",
          "sequenceIndex",
          "title",
          "shots",
          "trace"
        ],
        "properties": {
          "chapterID": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "sequenceIndex": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "shots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "shotID",
                "sequenceIndex",
                "kind",
                "startFrame",
                "durationFrames",
                "transitionIn",
                "trace"
              ],
              "properties": {
                "shotID": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "sequenceIndex": {
                  "type": "integer",
                  "minimum": 0
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "title",
                    "chapter-title",
                    "photo",
                    "outro",
                    "video"
                  ]
                },
                "assetID": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "startFrame": {
                  "type": "integer",
                  "minimum": 0
                },
                "durationFrames": {
                  "type": "integer",
                  "minimum": 1
                },
                "title": {
                  "type": "string",
                  "maxLength": 320
                },
                "caption": {
                  "type": "object",
                  "properties": {
                    "body": {
                      "type": "string",
                      "maxLength": 240
                    },
                    "timeText": {
                      "type": "string",
                      "maxLength": 80
                    },
                    "locationText": {
                      "type": "string",
                      "maxLength": 120
                    }
                  },
                  "minProperties": 1,
                  "additionalProperties": false
                },
                "fit": {
                  "type": "object",
                  "required": [
                    "mode",
                    "allowCrop"
                  ],
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "contain",
                        "cover"
                      ]
                    },
                    "allowCrop": {
                      "type": "boolean"
                    },
                    "safeArea": {
                      "type": "object",
                      "required": [
                        "x",
                        "y",
                        "width",
                        "height"
                      ],
                      "properties": {
                        "x": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "y": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "width": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 1
                        },
                        "height": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 1
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "motion": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "static",
                        "subtle-push",
                        "pan-left",
                        "pan-right"
                      ]
                    },
                    "startScale": {
                      "type": "number",
                      "minimum": 0.85,
                      "maximum": 1.2
                    },
                    "endScale": {
                      "type": "number",
                      "minimum": 0.85,
                      "maximum": 1.2
                    },
                    "distanceRatio": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 0.15
                    }
                  },
                  "additionalProperties": false
                },
                "transitionIn": {
                  "type": "object",
                  "required": [
                    "type",
                    "durationFrames"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "cut",
                        "fade"
                      ]
                    },
                    "durationFrames": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 90
                    }
                  },
                  "additionalProperties": false
                },
                "trace": {
                  "type": "object",
                  "required": [
                    "originalShotID"
                  ],
                  "properties": {
                    "originalShotID": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "upstreamStrategyVersion": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    }
                  },
                  "additionalProperties": false
                },
                "videoClip": {
                  "type": "object",
                  "required": [
                    "inFrame",
                    "outFrame",
                    "originalAudioGain"
                  ],
                  "properties": {
                    "inFrame": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "outFrame": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "originalAudioGain": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "photo"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "then": {
                    "required": [
                      "assetID",
                      "fit",
                      "motion"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "video"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "then": {
                    "required": [
                      "assetID",
                      "fit",
                      "videoClip"
                    ],
                    "not": {
                      "required": [
                        "motion"
                      ]
                    }
                  },
                  "else": {
                    "not": {
                      "required": [
                        "videoClip"
                      ]
                    }
                  }
                }
              ],
              "additionalProperties": false
            }
          },
          "trace": {
            "type": "object",
            "required": [
              "sourceChapterID"
            ],
            "properties": {
              "sourceChapterID": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "upstreamStrategyVersion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "audio": {
      "type": "object",
      "required": [
        "assetID",
        "offsetFrame",
        "volume",
        "fadeInFrames",
        "fadeOutFrames"
      ],
      "properties": {
        "assetID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "offsetFrame": {
          "type": "integer",
          "minimum": 0
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fadeInFrames": {
          "type": "integer",
          "minimum": 0
        },
        "fadeOutFrames": {
          "type": "integer",
          "minimum": 0
        },
        "loop": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "trace": {
      "type": "object",
      "required": [
        "upstreamPolicyVersion"
      ],
      "properties": {
        "upstreamPolicyVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "exporterVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
